body {
    font-family: Lexend;
    font-size: 25px;
    color: #ffffff;
    background: rgba(0, 0, 0, 25%);
    text-align: center;

    padding: 2em 3em;

    border: 2px rgba(0, 0, 0, 35%);
    margin: 20px;

    border-radius: 20px;
}

h1 {
    color: #f6470a;
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 0.7em;
}

p {
    margin: 0.7em 0;
}

#mouse {
    font-weight: bold;
}

input.text {
    background-color: #fff;
    color: #555;
    border: 2px #999;
    padding: 5px;
    tab-index: auto;
    cursor: text;
    box-sizing: border-box;
    width: 200px;
    font-size: 0.9em;
}

.info {
    border-radius: 20px;
    padding: 0 20px;

    background-color: rgba(0, 0, 0, 25%);

    transition: border-radius background-color 1.6s elastic-out;
}

.info:hover {
    border-radius: 50px;
    background-color: rgba(0, 0, 0, 15%);
}
